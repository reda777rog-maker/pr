# Obligatoire : Claude écrit le scénario du film.
ANTHROPIC_API_KEY=sk-ant-...

# Optionnel : active les modes « Images IA » et « Vidéo IA » (https://replicate.com/account/api-tokens).
REPLICATE_API_TOKEN=

# Modèles Replicate utilisés (modifiables).
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
REPLICATE_VIDEO_MODEL=minimax/video-01

# Modèle Claude pour l'écriture du scénario.
CLAUDE_MODEL=claude-opus-5-5

# Dossier où sont enregistrés les films générés.
FILMS_DIR=films
